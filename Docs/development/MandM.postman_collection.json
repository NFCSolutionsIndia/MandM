                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "GET /admin/v1/dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/v1/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "v1",
                "dashboard"
              ]
            },
            "description": "Everything the console's home screen draws. Run `npm run seed:dev` first or the numbers are all zero.\n\nWorth noticing what is NOT here: no capsule contents. The console connects as mm_admin, which has a column-level grant letting it count capsules and read unlock_at, but no SELECT on sender_note at all. Operations can see that a capsule exists without reading what somebody wrote to their daughter."
          }
        },
        {
          "name": "GET /admin/v1/dashboard — with a CUSTOMER token (expect 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/v1/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "v1",
                "dashboard"
