*.xcuserstate
xcuserdata/
DerivedData/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
Pods/
# Android
*.iml
.gradle/
local.properties
.cxx/
captures/

# ─── editors and OS ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ─── logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
