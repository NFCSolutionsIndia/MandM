# Moments & Memories — backend environment
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# committed, so it must list every variable the service reads and never contain
# a real secret.
#
# The authoritative list is backend/src/config/env.schema.ts — the application
# refuses to start if anything here is missing or malformed.

# development | test | production
NODE_ENV=development

PORT=3000

# PostgreSQL. Must start with postgres:// or postgresql://.
# Local development runs PostgreSQL 17 in Docker — see TASK-008.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/mm_dev
