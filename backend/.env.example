# Moments & Memories — backend environment
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# committed, so it must list every variable the service reads and never contain
# a real secret.
#
# The authoritative list is backend/src/config/env.schema.ts — the application
# refuses to start if anything here is missing or malformed.

# development | test | production
NODE_ENV=development

PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
#
# TWO credentials, deliberately. They are not interchangeable.
#
#   DATABASE_URL            the application role, mm_app
#   MIGRATION_DATABASE_URL  the table owner, used only by drizzle-kit
#
# PostgreSQL bypasses row-level security for a superuser AND for a table's
# owner. Pointing DATABASE_URL at `postgres` leaves every policy in place
# enforcing nothing — no error, no failing test, and every family's memories
# readable by every request. See migration 0002.
#
# mm_app is created by that migration with NOLOGIN and no password; grant it
# locally with:
#
#   ALTER ROLE mm_app WITH LOGIN PASSWORD '<password>';
#
# On a server both values come from AWS Secrets Manager, and the API task is
# given only DATABASE_URL — a container serving requests has no business
# holding a credential that can DROP a table.

DATABASE_URL=postgres://mm_app:password@127.0.0.1:5432/mm_dev
MIGRATION_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/mm_dev

# Connections per process. The figure that reaches the database is
# containers × DB_POOL_MAX, and Aurora has a hard ceiling on it.
DB_POOL_MAX=10

# Enforced by PostgreSQL, not by this process, so they survive a client that
# stops listening.
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=10000

# ─── Tests ───────────────────────────────────────────────────────────────────
#
# The integration suite applies the real migrations and then DELETES every row,
# so it refuses to start unless both of these name mm_test.
TEST_DATABASE_URL=postgres://mm_app:password@127.0.0.1:5432/mm_test
TEST_MIGRATION_DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/mm_test
